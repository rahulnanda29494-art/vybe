# ---- Database (PostgreSQL). Leave unset to run on bundled sample data.
DATABASE_URL=postgres://vybe:vybe@localhost:5432/vybe
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# ---- Auth. Must be >= 32 random characters in production.
JWT_SECRET=

# ---- Object storage: "local" (./.storage) or "s3" (S3 / R2 / MinIO)
STORAGE_DRIVER=local
STORAGE_BUCKET=vybe-media
STORAGE_ENDPOINT=https://s3.example.com
STORAGE_PUBLIC_URL=https://cdn.example.com
STORAGE_SECRET=

# ---- YouTube. Leave the key empty to run on curated channel RSS feeds.
# Get one: console.cloud.google.com → APIs & Services → enable
# "YouTube Data API v3" → Credentials → Create API key.
YOUTUBE_API_KEY=
YOUTUBE_REGION=IN
YOUTUBE_LANGUAGE=

# ---- Groq (optional) — LLM inference for AI features.
GROQ_API_KEY=
